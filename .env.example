# ============================================
# CoerVora AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.

# --- General ---
APP_NAME=CoerVora AI
APP_ENV=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_USER=coervora
POSTGRES_PASSWORD=coervora_secret_change_me
POSTGRES_DB=coervora_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=CoerVora AI

# --- AI Engine ---
AI_ENGINE_HOST=ai-engine
AI_ENGINE_PORT=8001

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8200
CHROMA_COLLECTION_PREFIX=coervora_

# --- Ollama ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2:7b

# --- OpenAI Compatible (optional) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
